NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Solo para scripts administrativos; nunca NEXT_PUBLIC_ ni en el navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Vista previa pública y de solo lectura; desactiva al conectar la operación real.
ZEROCLIPS_PREVIEW_MODE=false

# Correo exacto autorizado para asignación automática de administrador.
# Requiere correo verificado y SUPABASE_SERVICE_ROLE_KEY exclusivamente en servidor.
ZEROCLIPS_ADMIN_EMAIL=
